# Database dumps written by the production stack's `/backups` mount. Never
# committed: they are the whole database, secrets and customer data included.
backups/

.vercel/

# ---- Editors / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.DS_Store
Thumbs.db
desktop.ini

# Uploaded documents. Never committed: they are customer data, and they are the
# supporting evidence for ledger entries, so they belong in the backup story
# (rsync the directory) rather than in version control.
backend/var/
credentials.json
token.pickle