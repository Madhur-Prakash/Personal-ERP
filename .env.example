# =============================================================================
# Personal ERP - environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true
APP_NAME="Personal ERP"
APP_VERSION=0.1.0

# ---- Backend HTTP -----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated. Must be explicit origins (no "*") because we send credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Hosts the API will answer for. Blocks Host-header attacks in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=personalerp
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=personalerp
# Optional: full override. If unset it is composed from the parts above.
# DATABASE_URL=postgresql+asyncpg://personalerp:change-me@postgres:5432/personalerp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379/0

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-key-replace-me-with-64-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Argon2id tuning. Raise memory_cost on beefier hardware.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Fernet key for encrypting 2FA secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Auth policy ------------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
MAGIC_LINK_TTL_MINUTES=15
OTP_TTL_MINUTES=10
OTP_LENGTH=6
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITE_TTL_DAYS=7

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# ---- Logifyx (backend logging) ---------------------------------------------
# See https://pypi.org/project/logifyx/ - these are read by logifyx itself.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=personalerp.log
LOG_COLOR=true
LOG_JSON=false                     # set true in production for aggregators
LOG_MASK=true                      # redacts passwords/tokens/secrets
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
# LOG_REMOTE=http://loki:3100/loki/api/v1/push
# LOG_KAFKA_SERVERS=kafka:9092
# LOG_KAFKA_TOPIC=personalerp-logs

# ---- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty in dev: emails are written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@personalerp.local
SMTP_FROM_NAME="Personal ERP"
SMTP_TLS=true

# ---- Documents & OCR --------------------------------------------------------
# Uploaded invoices go to the filesystem, not the database: they are megabytes of
# opaque bytes no query ever reads, and a directory is what makes rsync-ing the
# whole install a viable backup story.
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=15728640          # 15 MB; a 600 dpi colour A4 scan is ~8 MB
OCR_ENABLED=true

# Reading needs the `ocr` extra AND the Tesseract binary:
#   uv sync --extra ocr
#   Windows: https://github.com/UB-Mannheim/tesseract/wiki
#   Debian:  apt install tesseract-ocr
# The Windows installer does not add itself to PATH, so set this if it is not found.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGES=eng                  # "+"-separated; each pack must be installed
OCR_TIMEOUT_SECONDS=30

# ---- Frontend (Vite; only VITE_* is exposed to the browser) -----------------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_PREFIX=/api/v1
VITE_APP_NAME="Personal ERP"
