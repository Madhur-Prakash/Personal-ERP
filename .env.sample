# =============================================================================
# Personal ERP — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT = "YOUR_ENVIRONMENT"
DEBUG = "YOUR_DEBUG"
APP_NAME = "YOUR_APP_NAME"
APP_VERSION = "YOUR_APP_VERSION"

# ---- Backend HTTP -----------------------------------------------------------
BACKEND_HOST = "YOUR_BACKEND_HOST"
BACKEND_PORT = "YOUR_BACKEND_PORT"
API_V1_PREFIX = "YOUR_API_V1_PREFIX"
# Comma-separated. Must be explicit origins (no "*") because we send credentials.
CORS_ORIGINS = "YOUR_CORS_ORIGINS"
# Hosts the API will answer for. Blocks Host-header attacks in production.
ALLOWED_HOSTS = "YOUR_ALLOWED_HOSTS"

# ---- Browser origin check ----------------------------------------------------
# authentication and rate limiting.
ENFORCE_ORIGIN = "YOUR_ENFORCE_ORIGIN"

TRUST_PROXY_HEADERS = "YOUR_TRUST_PROXY_HEADERS"

TRUSTED_PROXY_HOPS = "YOUR_TRUSTED_PROXY_HOPS"

MAX_REQUEST_BYTES = "YOUR_MAX_REQUEST_BYTES"

HSTS_MAX_AGE = "YOUR_HSTS_MAX_AGE"

HSTS_PRELOAD = "YOUR_HSTS_PRELOAD"

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST = "YOUR_POSTGRES_HOST"
POSTGRES_PORT = "YOUR_POSTGRES_PORT"
POSTGRES_USER = "YOUR_POSTGRES_USER"
POSTGRES_PASSWORD = "YOUR_POSTGRES_PASSWORD"
POSTGRES_DB = "YOUR_POSTGRES_DB"
# Optional: full override. If unset it is composed from the parts above.
# DATABASE_URL=postgresql://personalerp:elQYuV5cBXEbjRfYOlvhevMiUsx3y8LJ@dpg-d9piqie1egvs73ffrgj0-a/personalerp
DB_POOL_SIZE = "YOUR_DB_POOL_SIZE"
DB_MAX_OVERFLOW = "YOUR_DB_MAX_OVERFLOW"
DB_POOL_RECYCLE = "YOUR_DB_POOL_RECYCLE"
DB_ECHO = "YOUR_DB_ECHO"

RUN_MIGRATIONS_ON_STARTUP = "YOUR_RUN_MIGRATIONS_ON_STARTUP"

# ---- Redis ------------------------------------------------------------------
REDIS_HOST = "YOUR_REDIS_HOST"
REDIS_PORT = "YOUR_REDIS_PORT"
REDIS_DB = "YOUR_REDIS_DB"
REDIS_PASSWORD = "YOUR_REDIS_PASSWORD"
# REDIS_URL=redis://red-d8bu4ke7r5hc738u2fq0:6379

# ---- Security -----------------------------------------------------------
SECRET_KEY = "YOUR_SECRET_KEY"
JWT_ALGORITHM = "YOUR_JWT_ALGORITHM"
ACCESS_TOKEN_TTL_MINUTES = "YOUR_ACCESS_TOKEN_TTL_MINUTES"
REFRESH_TOKEN_TTL_DAYS = "YOUR_REFRESH_TOKEN_TTL_DAYS"
ARGON2_TIME_COST = "YOUR_ARGON2_TIME_COST"
ARGON2_MEMORY_COST = "YOUR_ARGON2_MEMORY_COST"
ARGON2_PARALLELISM = "YOUR_ARGON2_PARALLELISM"
ENCRYPTION_KEY = "YOUR_ENCRYPTION_KEY"

# ---- Auth policy --------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS = "YOUR_EMAIL_VERIFICATION_TTL_HOURS"
PASSWORD_RESET_TTL_MINUTES = "YOUR_PASSWORD_RESET_TTL_MINUTES"
MAGIC_LINK_TTL_MINUTES = "YOUR_MAGIC_LINK_TTL_MINUTES"
OTP_TTL_MINUTES = "YOUR_OTP_TTL_MINUTES"
OTP_LENGTH = "YOUR_OTP_LENGTH"
MAX_LOGIN_ATTEMPTS = "YOUR_MAX_LOGIN_ATTEMPTS"
LOGIN_LOCKOUT_MINUTES = "YOUR_LOGIN_LOCKOUT_MINUTES"
INVITE_TTL_DAYS = "YOUR_INVITE_TTL_DAYS"

# ---- Rate limiting ------------------------------------------------------
#: Budgets are written ``"<count>/<period>"`` (``second``, ``minute``, ``hour``,
#: ``day``). Each is a token bucket: the bucket holds ``count`` tokens and refills
#: at ``count`` per ``period``, so a client may burst up to the full budget and then
#: settles into the sustained rate. See :mod:`app.core.ratelimit` for why a bucket
#: rather than a fixed window.
RATE_LIMIT_ENABLED = "YOUR_RATE_LIMIT_ENABLED"

#: Anything not matched by a more specific tier.
RATE_LIMIT_DEFAULT = "YOUR_RATE_LIMIT_DEFAULT"
#: Credential and enumeration surfaces: login, register, 2FA, token exchange.
RATE_LIMIT_AUTH = "YOUR_RATE_LIMIT_AUTH"
#: legitimate user needs a fourth reset email inside a minute.
RATE_LIMIT_AUTH_STRICT = "YOUR_RATE_LIMIT_AUTH_STRICT"
#: Reads: list, get, search.
#:
#: Note this is the budget a *dashboard* spends: opening one screen fires a dozen
#: requests, so the sustained rate here is roughly "screens per minute times ten".
#: The bucket refills continuously, so a burst on page load is absorbed; sustained
#: navigation faster than the refill rate is what gets throttled.
RATE_LIMIT_READ = "YOUR_RATE_LIMIT_READ"

#: Writes: POST/PATCH/PUT/DELETE outside auth. Each one costs a transaction and
#: usually an audit row, so the budget is an order of magnitude below reads.
RATE_LIMIT_WRITE = "YOUR_RATE_LIMIT_WRITE"
#: Document uploads. Every one runs OCR inline, which is seconds of CPU - this is
#: the most expensive thing an authenticated user can ask for.
RATE_LIMIT_UPLOAD = "YOUR_RATE_LIMIT_UPLOAD"
#: Report exports (xlsx/pdf/csv). Each renders a full statement in memory.
RATE_LIMIT_EXPORT = "YOUR_RATE_LIMIT_EXPORT"

#: the choice took effect instead of reporting a mistake.
RATE_LIMIT_IP = "YOUR_RATE_LIMIT_IP"


# ---- Per-endpoint budgets ---------------------------------------------------

# /login and the 2FA + recovery-code endpoints. Bounds guessing from one source; the
# per-account lockout (MAX_LOGIN_ATTEMPTS) handles the account side.
RATE_LIMIT_LOGIN = "YOUR_RATE_LIMIT_LOGIN"

# /register - account-creation spam costs a row and an email each.
RATE_LIMIT_REGISTER = "YOUR_RATE_LIMIT_REGISTER"

# Everything that SENDS MAIL: forgot-password, magic-link, OTP, resend-verification.
# The tightest budget here on purpose - abuse spends someone else's inbox and this
# deployment's sending reputation, and a burned sending domain does not recover quickly.
# Raise this one if "reset code" requests are being refused too eagerly.
RATE_LIMIT_MAIL_SENDING = "YOUR_RATE_LIMIT_MAIL_SENDING"

# /refresh - one call per access-token lifetime is all a client needs.
RATE_LIMIT_TOKEN_EXCHANGE = "YOUR_RATE_LIMIT_TOKEN_EXCHANGE"

# ---- Email (Gmail API) -----------------------------------------------------
GMAIL_CREDENTIALS_B64 = "YOUR_GMAIL_CREDENTIALS_B64"
GMAIL_SENDER = "YOUR_GMAIL_SENDER"
EMAIL_FROM_NAME = "YOUR_EMAIL_FROM_NAME"

# ---- Frontend -----------------------------------------------------------
frontend_url = "YOUR_frontend_url"

# 10 MB default accepts real documents and refuses everything else.
MAX_UPLOAD_BYTES = "YOUR_MAX_UPLOAD_BYTES"

# ---- Document storage --------------------------------------------------------
# Documents are stored in PostgreSQL by default.
# To use object storage instead, configure all three settings below and start
# the MinIO service (`make up-objectstore`).
# env vars to consider: MINIO_ENDPOINT, MINIO_ACCESS_KEY and MINIO_SECRET_KEY, then start MinIO (`make up-objectstore`).

# Existing documents are not migrated automatically. Use:
#     uv run python scripts/migrate_document_blobs.py --to object
#     uv run python scripts/migrate_document_blobs.py --to database
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=admin
# MINIO_SECRET_KEY=yourpassword
# MINIO_BUCKET=personalerp-documents
# MINIO_SECURE=false

# Read by docker compose to start MinIO with credentials matching the above. Harmless
# when the objectstore profile is off - nothing reads them.
MINIO_ROOT_USER = "YOUR_MINIO_ROOT_USER"
MINIO_ROOT_PASSWORD = "YOUR_MINIO_ROOT_PASSWORD"


# ---- Logifyx (backend logging) ---------------------------------------------
# See https://pypi.org/project/logifyx/ — these are read by logifyx itself.
LOG_FILE = "YOUR_LOG_FILE"

# ---- OCR --------------------------------------------------------------------
# Absolute path to the Tesseract binary; blank means "find it on PATH". Needed on
# Windows, whose installer does not add itself to PATH
# (e.g. C:/Program Files/Tesseract-OCR/tesseract.exe). Leave it host-shaped: the
# compose files override it with /usr/bin/tesseract for the container, so a value
# here that suits your machine does not break the Docker stack.
#
# Every language in OCR_LANGUAGES needs its own pack installed alongside the binary
# ("eng+hin" needs tesseract-ocr-hin in backend/Dockerfile); naming a missing one
# fails recognition rather than degrading it.
TESSERACT_CMD = "YOUR_TESSERACT_CMD"
OCR_ENABLED = "YOUR_OCR_ENABLED"
OCR_LANGUAGES = "YOUR_OCR_LANGUAGES"
OCR_TIMEOUT_SECONDS = "YOUR_OCR_TIMEOUT_SECONDS"

# ---- Frontend (Vite; only VITE_* is exposed to the browser) -----------------
VITE_API_BASE_URL = "YOUR_VITE_API_BASE_URL"
VITE_API_V1_PREFIX = "YOUR_VITE_API_V1_PREFIX"
VITE_APP_NAME = "YOUR_VITE_APP_NAME"

