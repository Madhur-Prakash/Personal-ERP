# =============================================================================
# Personal ERP — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT = "YOUR_ENVIRONMENT"
DEBUG = "YOUR_DEBUG"
APP_NAME = "YOUR_APP_NAME"
APP_VERSION = "YOUR_APP_VERSION"

# ---- Backend HTTP -----------------------------------------------------------
BACKEND_HOST = "YOUR_BACKEND_HOST"
BACKEND_PORT = "YOUR_BACKEND_PORT"
API_V1_PREFIX = "YOUR_API_V1_PREFIX"
# Comma-separated. Must be explicit origins (no "*") because we send credentials.
CORS_ORIGINS = "YOUR_CORS_ORIGINS"
# Hosts the API will answer for. Blocks Host-header attacks in production.
ALLOWED_HOSTS = "YOUR_ALLOWED_HOSTS"

# ---- Object storage (MinIO) --------------------------------------------------
# Documents are stored here, not on disk. The dev stack runs MinIO in docker
# compose; console at http://localhost:9001 with the same credentials.
#
# Leave MINIO_ENDPOINT blank to fall back to local disk storage.
MINIO_ENDPOINT = "YOUR_MINIO_ENDPOINT"
MINIO_ACCESS_KEY = "YOUR_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY = "YOUR_MINIO_SECRET_KEY"
MINIO_BUCKET = "YOUR_MINIO_BUCKET"
# Plain HTTP to a local MinIO. Must be true for anything across a network.
MINIO_SECURE = "YOUR_MINIO_SECURE"

# Used by docker compose to start MinIO with matching credentials.
MINIO_ROOT_USER = "YOUR_MINIO_ROOT_USER"
MINIO_ROOT_PASSWORD = "YOUR_MINIO_ROOT_PASSWORD"

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST = "YOUR_POSTGRES_HOST"
POSTGRES_PORT = "YOUR_POSTGRES_PORT"
POSTGRES_USER = "YOUR_POSTGRES_USER"
POSTGRES_PASSWORD = "YOUR_POSTGRES_PASSWORD"
POSTGRES_DB = "YOUR_POSTGRES_DB"
# Optional: full override. If unset it is composed from the parts above.
# DATABASE_URL=postgresql+asyncpg://personalerp:change-me@postgres:5432/personalerp
DB_POOL_SIZE = "YOUR_DB_POOL_SIZE"
DB_MAX_OVERFLOW = "YOUR_DB_MAX_OVERFLOW"
DB_POOL_RECYCLE = "YOUR_DB_POOL_RECYCLE"
DB_ECHO = "YOUR_DB_ECHO"

# ---- Redis ------------------------------------------------------------------
REDIS_HOST = "YOUR_REDIS_HOST"
REDIS_PORT = "YOUR_REDIS_PORT"
REDIS_DB = "YOUR_REDIS_DB"
REDIS_PASSWORD = "YOUR_REDIS_PASSWORD"
# REDIS_URL=redis://redis:6379/0

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY = "YOUR_SECRET_KEY"
JWT_ALGORITHM = "YOUR_JWT_ALGORITHM"
ACCESS_TOKEN_TTL_MINUTES = "YOUR_ACCESS_TOKEN_TTL_MINUTES"
REFRESH_TOKEN_TTL_DAYS = "YOUR_REFRESH_TOKEN_TTL_DAYS"
# Argon2id tuning. Raise memory_cost on beefier hardware.
ARGON2_TIME_COST = "YOUR_ARGON2_TIME_COST"
ARGON2_MEMORY_COST = "YOUR_ARGON2_MEMORY_COST"
ARGON2_PARALLELISM = "YOUR_ARGON2_PARALLELISM"
# Fernet key for encrypting 2FA secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY = "YOUR_ENCRYPTION_KEY"

# ---- Auth policy ------------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS = "YOUR_EMAIL_VERIFICATION_TTL_HOURS"
PASSWORD_RESET_TTL_MINUTES = "YOUR_PASSWORD_RESET_TTL_MINUTES"
MAGIC_LINK_TTL_MINUTES = "YOUR_MAGIC_LINK_TTL_MINUTES"
OTP_TTL_MINUTES = "YOUR_OTP_TTL_MINUTES"
OTP_LENGTH = "YOUR_OTP_LENGTH"
MAX_LOGIN_ATTEMPTS = "YOUR_MAX_LOGIN_ATTEMPTS"
LOGIN_LOCKOUT_MINUTES = "YOUR_LOGIN_LOCKOUT_MINUTES"
INVITE_TTL_DAYS = "YOUR_INVITE_TTL_DAYS"

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED = "YOUR_RATE_LIMIT_ENABLED"
RATE_LIMIT_DEFAULT = "YOUR_RATE_LIMIT_DEFAULT"
RATE_LIMIT_AUTH = "YOUR_RATE_LIMIT_AUTH"

# ---- Logifyx (backend logging) ---------------------------------------------
# See https://pypi.org/project/logifyx/ — these are read by logifyx itself.
LOG_LEVEL = "YOUR_LOG_LEVEL"
LOG_DIR = "YOUR_LOG_DIR"
LOG_FILE = "YOUR_LOG_FILE"
LOG_COLOR = "YOUR_LOG_COLOR"
LOG_JSON = "YOUR_LOG_JSON"
LOG_MASK = "YOUR_LOG_MASK"
LOG_MAX_BYTES = "YOUR_LOG_MAX_BYTES"
LOG_BACKUP_COUNT = "YOUR_LOG_BACKUP_COUNT"
# LOG_REMOTE=http://loki:3100/loki/api/v1/push
# LOG_KAFKA_SERVERS=kafka:9092
# LOG_KAFKA_TOPIC=personalerp-logs

# ---- Email (Gmail API) ------------------------------------------------------
# The only mail transport. There is no SMTP path: Google refuses plain passwords,
# and app passwords hang off a setting any Workspace admin can switch off, so a
# refresh token scoped to gmail.send is what this uses.
#
# Unset means mail is written to the log instead of sent, including verification
# and reset links. That is the default, and it is what lets a fresh checkout and
# the test suite run with no credentials.

# Base64 of a pickled google.oauth2.credentials.Credentials for the account that
# sends mail. Required scope:
#   https://www.googleapis.com/auth/gmail.send
#
# Produce it with the script - it runs the consent flow and prints the finished
# line, so there is nothing to encode by hand:
#   cd backend && uv run python scripts/mint_gmail_token.py path/to/credentials.json
#
# It is base64 because a .env value cannot hold the raw bytes of a pickle. This is a
# long-lived credential for sending as that mailbox - it belongs in a secret store,
# never in a commit.
#
# Note the expiry trap: while the OAuth consent screen is in "Testing", Google
# expires the refresh token after 7 days and sending fails with invalid_grant.
# Publish the app to keep a token working.
#
# Left commented deliberately: any non-empty value switches sending on, so a
# placeholder copied across from this file would make every email fail. Uncomment
# it only with a real token.
# GMAIL_CREDENTIALS_B64=gASVrwQAAAAAAACM...

# The mailbox to send from. Must be the authorised account or one of its verified
# "send mail as" aliases - Gmail will not send as an arbitrary address. Left unset,
# the From header is omitted and Gmail fills in the authorised mailbox, which is
# correct but carries no display name.
# GMAIL_SENDER=no-reply@yourdomain.com

# The display name on outgoing mail, used when GMAIL_SENDER is set.
EMAIL_FROM_NAME = "YOUR_EMAIL_FROM_NAME"

# ---- OCR --------------------------------------------------------------------
# Absolute path to the Tesseract binary. Leave blank to find it on PATH, which is
# the right default on Linux and in Docker.
#
# Set explicitly here because the Windows installer does not add itself to PATH,
# so "it works on my machine" and "it works on the server" diverge silently - the
# engine simply reports itself unavailable and every scan falls back to the PDF
# text layer, with no error to explain why.
TESSERACT_CMD = "YOUR_TESSERACT_CMD"
OCR_ENABLED = "YOUR_OCR_ENABLED"
OCR_LANGUAGES = "YOUR_OCR_LANGUAGES"
OCR_TIMEOUT_SECONDS = "YOUR_OCR_TIMEOUT_SECONDS"

# ---- Frontend (Vite; only VITE_* is exposed to the browser) -----------------
VITE_API_BASE_URL = "YOUR_VITE_API_BASE_URL"
VITE_API_V1_PREFIX = "YOUR_VITE_API_V1_PREFIX"
VITE_APP_NAME = "YOUR_VITE_APP_NAME"