# =============================================================================
# Personal ERP — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT = "YOUR_ENVIRONMENT"
DEBUG = "YOUR_DEBUG"
APP_NAME = "YOUR_APP_NAME"
APP_VERSION = "YOUR_APP_VERSION"

# ---- Backend HTTP -----------------------------------------------------------
BACKEND_HOST = "YOUR_BACKEND_HOST"
BACKEND_PORT = "YOUR_BACKEND_PORT"
API_V1_PREFIX = "YOUR_API_V1_PREFIX"
# Comma-separated. Must be explicit origins (no "*") because we send credentials.
# In production every entry must be https:// - the refresh cookie is Secure, so an
# http:// origin produces a frontend that cannot stay signed in.
CORS_ORIGINS = "YOUR_CORS_ORIGINS"
# Hosts the API will answer for. Blocks Host-header attacks in production.
ALLOWED_HOSTS = "YOUR_ALLOWED_HOSTS"

# ---- Edge gateway (only our own proxy may reach the API) ---------------------
# The shared secret the edge proxy stamps on every request it forwards, and the
# backend refuses any request without.
#
# This is what makes "only our frontend can call the API" real. A browser bundle and
# a desktop binary are both public code - any header *they* hold, an attacker reads
# out and replays. The proxy is different: it runs on your machine, and a value it
# injects server-side never reaches a user. So the property enforced is "this request
# came through our edge", which is the one that can actually be checked.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Set the SAME value in infra/nginx/conf.d/app.conf (proxy_set_header X-Gateway-Key).
# Leave blank for local development - the check is skipped when unset. Production
# REFUSES TO START without it unless ALLOW_DIRECT_BACKEND_ACCESS=true.
GATEWAY_SECRET = "YOUR_GATEWAY_SECRET"
GATEWAY_HEADER = "X-Gateway-Key"

# Serve production with no gateway secret, on purpose. Only for a topology where this
# service *is* the public edge (a lone Render/Fly app with no proxy of your own). You
# keep auth, rate limits, headers, host and origin checks; you lose the guarantee that
# traffic came through your edge.
ALLOW_DIRECT_BACKEND_ACCESS = "false"

# Reject state-changing requests whose Origin/Referer is not in CORS_ORIGINS.
# Defence in depth behind SameSite=Strict. Browsers cannot forge these headers;
# non-browser clients send neither and are unaffected.
ENFORCE_ORIGIN = "true"

# ---- Proxy trust ------------------------------------------------------------
# Whether X-Forwarded-For may be used to identify the caller. True behind any reverse
# proxy (nginx, Render, Fly, a load balancer); harmless locally where no such header
# arrives. Safe because the address is taken from the RIGHT of the list - the end our
# own proxy appends - not the left-most value, which the caller writes.
TRUST_PROXY_HEADERS = "true"

# How many proxies sit between the internet and this process. 1 for a single nginx or
# PaaS router; 2 for a CDN in front of nginx. Setting this too high hands the client
# control of its own apparent IP, which defeats every IP-keyed control.
TRUSTED_PROXY_HOPS = "1"

# Ceiling on a non-upload request body, in bytes. Checked from Content-Length before
# the body is read, and counted while streaming when no length is declared. File
# uploads are bounded by MAX_UPLOAD_BYTES instead.
MAX_REQUEST_BYTES = "1048576"

# HSTS. `preload` is effectively permanent and commits every subdomain to HTTPS
# forever, so turn it on only once TLS is known to work everywhere.
HSTS_MAX_AGE = "63072000"
HSTS_PRELOAD = "false"

# ---- Document storage --------------------------------------------------------
# Nothing to configure. Uploaded documents are compressed and stored in PostgreSQL
# (the `document_blob` table, as BYTEA), in the same transaction as the row that
# describes them - so one `pg_dump` captures the books and their supporting scans at
# one consistent point in time, and a failed upload leaves nothing behind.
#
# OPTIONAL: object storage, for an install whose blobs have outgrown the database
# (roughly past tens of gigabytes, where they start dominating dump time and WAL).
#
# Setting all three of endpoint / access key / secret switches the backend; leaving any of
# them blank keeps PostgreSQL. Two out of three counts as "not configured", because a
# half-finished config that boots and then fails on first upload is worse than one that
# does not switch at all.
#
# For a local MinIO to point it at, the development stack has one behind a compose
# profile - off by default, since the container should not run unless you chose it:
#
#     make up-objectstore        # docker compose --profile objectstore up -d
#
# The trade costs you the single consistent dump: document durability becomes yours to
# arrange, and a restore can reinstate rows pointing at objects from a different moment.
# Move existing blobs either way with:
#
#     uv run python scripts/migrate_document_blobs.py --to object
#     uv run python scripts/migrate_document_blobs.py --to database
#
# MINIO_ENDPOINT=s3.example.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=personalerp-documents
# MINIO_SECURE=true      # false only for a store on loopback

# Read by docker compose to start the profiled MinIO with matching credentials. Unused
# by the application itself.
MINIO_ROOT_USER = "YOUR_MINIO_ROOT_USER"
MINIO_ROOT_PASSWORD = "YOUR_MINIO_ROOT_PASSWORD"

# Hard ceiling on one upload, in bytes. A 600 dpi colour A4 scan is ~8 MB, so the
# 10 MB default accepts real documents and refuses everything else.
MAX_UPLOAD_BYTES = "10485760"

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST = "YOUR_POSTGRES_HOST"
POSTGRES_PORT = "YOUR_POSTGRES_PORT"
POSTGRES_USER = "YOUR_POSTGRES_USER"
POSTGRES_PASSWORD = "YOUR_POSTGRES_PASSWORD"
POSTGRES_DB = "YOUR_POSTGRES_DB"
# Optional: full override. If unset it is composed from the parts above; when
# set, the parts are ignored entirely. Paste a managed-Postgres URL as given --
# a postgres://, postgresql:// or postgresql+psycopg:// scheme is rewritten to
# the async driver for you. Do NOT append ?sslmode=... : SQLAlchemy forwards
# query params straight to asyncpg.connect(), which has no such keyword and
# raises TypeError. asyncpg already negotiates TLS by default (sslmode=prefer).
# DATABASE_URL=postgresql+asyncpg://personalerp:change-me@postgres:5432/personalerp
DB_POOL_SIZE = "YOUR_DB_POOL_SIZE"
DB_MAX_OVERFLOW = "YOUR_DB_MAX_OVERFLOW"
DB_POOL_RECYCLE = "YOUR_DB_POOL_RECYCLE"
DB_ECHO = "YOUR_DB_ECHO"

# Run `alembic upgrade head` at startup, before the app serves anything.
#
# Turn this on where there is nowhere else to put a release step - a single Render
# service, a bare `docker run` - and a fresh database becomes usable without a manual
# migrate. Idempotent: an up-to-date database does nothing, an empty one gets every
# migration, and the revision is recorded either way.
#
# Leave it off for anything that deploys in stages: replicas rolling out together
# would each try to run DDL (an advisory lock makes them queue rather than fail), and
# a long migration delays the boot of every one of them. `make migrate` instead.
RUN_MIGRATIONS_ON_STARTUP = "false"

# ---- Redis ------------------------------------------------------------------
REDIS_HOST = "YOUR_REDIS_HOST"
REDIS_PORT = "YOUR_REDIS_PORT"
REDIS_DB = "YOUR_REDIS_DB"
REDIS_PASSWORD = "YOUR_REDIS_PASSWORD"
# override the above parts with a full URL if you have one. async-redis supports
# redis://, rediss:// and unix:/// schemes. If you have a managed Redis URL
# REDIS_URL=redis://redis:6379/0

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY = "YOUR_SECRET_KEY"
JWT_ALGORITHM = "YOUR_JWT_ALGORITHM"
ACCESS_TOKEN_TTL_MINUTES = "YOUR_ACCESS_TOKEN_TTL_MINUTES"
REFRESH_TOKEN_TTL_DAYS = "YOUR_REFRESH_TOKEN_TTL_DAYS"
# Argon2id tuning. Raise memory_cost on beefier hardware.
ARGON2_TIME_COST = "YOUR_ARGON2_TIME_COST"
ARGON2_MEMORY_COST = "YOUR_ARGON2_MEMORY_COST"
ARGON2_PARALLELISM = "YOUR_ARGON2_PARALLELISM"
# Fernet key for encrypting 2FA secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY = "YOUR_ENCRYPTION_KEY"

# ---- Auth policy ------------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS = "YOUR_EMAIL_VERIFICATION_TTL_HOURS"
PASSWORD_RESET_TTL_MINUTES = "YOUR_PASSWORD_RESET_TTL_MINUTES"
MAGIC_LINK_TTL_MINUTES = "YOUR_MAGIC_LINK_TTL_MINUTES"
OTP_TTL_MINUTES = "YOUR_OTP_TTL_MINUTES"
OTP_LENGTH = "YOUR_OTP_LENGTH"
MAX_LOGIN_ATTEMPTS = "YOUR_MAX_LOGIN_ATTEMPTS"
LOGIN_LOCKOUT_MINUTES = "YOUR_LOGIN_LOCKOUT_MINUTES"
INVITE_TTL_DAYS = "YOUR_INVITE_TTL_DAYS"

# ---- Rate limiting ----------------------------------------------------------
# Written "<count>/<period>" where period is second | minute | hour | day.
#
# Each is a token bucket: it holds <count> tokens and refills at <count> per <period>,
# so a client may burst up to the full budget and then settles into the sustained rate.
# Buckets key on the authenticated user where there is one and on the resolved client IP
# otherwise, so one office behind a single NAT is not one shared budget.
RATE_LIMIT_ENABLED = "true"

# Anything not matched by a tier below.
RATE_LIMIT_DEFAULT = "15/minute"

# Credential, token and enumeration surfaces: login, register, refresh, 2FA,
# verify-email, invitation preview.
RATE_LIMIT_AUTH = "10/minute"

# The auth endpoints that send mail or mint a one-time secret: forgot-password,
# reset-password, magic-link, otp, resend-verification. Abuse here spends someone
# else's inbox and your sending reputation.
RATE_LIMIT_AUTH_STRICT = "3/minute"

# Safe methods (GET/HEAD/OPTIONS). Generous: a dashboard fires a dozen on open.
RATE_LIMIT_READ = "25/minute"

# POST/PATCH/PUT/DELETE outside auth. Each costs a transaction and an audit row.
RATE_LIMIT_WRITE = "15/minute"

# Document uploads - OCR runs inline, so these are seconds of CPU each.
RATE_LIMIT_UPLOAD = "5/minute"

# Report exports and document downloads: a full statement rendered in memory.
RATE_LIMIT_EXPORT = "5/minute"

# Per-IP ceiling applied on top of the tier above, authenticated or not. Bounds a
# single source that walks across cheap endpoints to stay under every other tier.
#
# CAREFUL: both buckets must have room, so a value BELOW any tier above makes that tier
# unreachable and this the only limit that binds - and this one bucket is shared by
# everyone behind a single NAT, so the symptom is intermittent 429s that track how many
# colleagues are online. The app logs a warning at startup naming any tier this eclipses.
# At the defaults here it eclipses RATE_LIMIT_READ (25/min), which is deliberate for a
# small self-hosted install; raise it to ~10x the largest tier for a shared office.
RATE_LIMIT_IP = "20/minute"

# NOTE: there is a SECOND rate limiter, and RATE_LIMIT_ENABLED governs both.
#
# The tiers above are the blanket layer (app/core/middleware.py), applied to every
# route by pattern. Alongside it, slowapi enforces per-endpoint budgets declared as
# decorators on the auth handlers themselves (app/core/limiter.py) - login, register,
# refresh, and the four mail-sending endpoints. Those budgets live in the router, next
# to the endpoint they protect, and are intentionally not configurable from here: they
# are properties of the endpoint rather than of the deployment, and a limit on the login
# form is not something an operator should be able to relax by accident.
#
# Both use this same Redis. Set RATE_LIMIT_ENABLED=false and neither runs.

# ---- Logifyx (backend logging) ---------------------------------------------
# See https://pypi.org/project/logifyx/ — these are read by logifyx itself.
LOG_LEVEL = "YOUR_LOG_LEVEL"
LOG_DIR = "YOUR_LOG_DIR"
LOG_FILE = "YOUR_LOG_FILE"
LOG_COLOR = "YOUR_LOG_COLOR"
LOG_JSON = "YOUR_LOG_JSON"
LOG_MASK = "YOUR_LOG_MASK"
LOG_MAX_BYTES = "YOUR_LOG_MAX_BYTES"
LOG_BACKUP_COUNT = "YOUR_LOG_BACKUP_COUNT"
# LOG_REMOTE=http://loki:3100/loki/api/v1/push
# LOG_KAFKA_SERVERS=kafka:9092
# LOG_KAFKA_TOPIC=personalerp-logs

# ---- OCR --------------------------------------------------------------------
# Absolute path to the Tesseract binary. Leave blank to find it on PATH, which is
# the right default on Linux and in Docker.
#
# Set explicitly here because the Windows installer does not add itself to PATH,
# so "it works on my machine" and "it works on the server" diverge silently - the
# engine simply reports itself unavailable and every scan falls back to the PDF
# text layer, with no error to explain why.
TESSERACT_CMD = "YOUR_TESSERACT_CMD"
OCR_ENABLED = "YOUR_OCR_ENABLED"
OCR_LANGUAGES = "YOUR_OCR_LANGUAGES"
OCR_TIMEOUT_SECONDS = "YOUR_OCR_TIMEOUT_SECONDS"

# ---- Frontend (Vite; only VITE_* is exposed to the browser) -----------------
VITE_API_BASE_URL = "YOUR_VITE_API_BASE_URL"
VITE_API_V1_PREFIX = "YOUR_VITE_API_V1_PREFIX"
VITE_APP_NAME = "YOUR_VITE_APP_NAME"

# ---- Email (Gmail API) -----------------------------------------------------
GMAIL_CREDENTIALS_B64 = "YOUR_GMAIL_CREDENTIALS_B64"
gmail_sender = "YOUR_gmail_sender"